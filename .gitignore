# QiDi Relay v4 - git baseline .gitignore (2026-10-03)
# Secrets & credentials (never commit)
config.json
config.json.bak*
config.json.tmp
accounts.json
auths/
agnes api.xlsx

# Runtime state & data
token_stats.json
water_check.json
seed_state.json
relay_knowledge.db
relay_knowledge.db-shm
relay_knowledge.db-wal
corpus_local/
corpus_state.json
media/

# Logs
*.log
*.log.1
*.log.2

# Dev instance & caches & backups
_dev8899/
__pycache__/
*.pyc
*.bak
*.bak-*
*.bak_*

# Large binaries
hunyuanocr/models/

# Publish hardening (2026-10-09, pre-push audit)
wb/accounts/
conversations.json
cooldowns.json
.pytest_cache/

# multi-suffix logs (proxy.log.3 etc.)
*.log.*
_tmp_*.txt

# qoder2api vendored bridge runtime data
qoder2api/accounts/
qoder2api/__pycache__/
qoder2api/*.log
qoder2api/*.pid

# antigravity bridge local secrets
antigravity_key.txt
antigravity2api.log
